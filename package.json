{
  "name": "junalippu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "pnpm typecheck && pnpm format:check && pnpm lint && pnpm test && pnpm test:db && pnpm test:integration && pnpm build",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed-demo-data.ts",
    "db:studio": "prisma studio",
    "dev": "next dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "setup": "pnpm db:migrate && pnpm db:seed",
    "start": "next start",
    "test": "tsx --test tests/journey.test.ts tests/service-date.test.ts tests/dataset-contract.test.ts",
    "test:db": "node scripts/run-test-db.mjs node --test tests/db-invariants.test.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:integration": "node scripts/run-test-db.mjs pnpm exec tsx --test --test-concurrency=1 tests/booking.integration.test.ts tests/search.integration.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^1.4.0",
    "@prisma/client": "7.10.0",
    "@t3-oss/env-nextjs": "^0.9.2",
    "@tanstack/react-query": "5.103.1",
    "@trpc/client": "11.19.0",
    "@trpc/next": "11.19.0",
    "@trpc/react-query": "11.19.0",
    "@trpc/server": "11.19.0",
    "next": "15.5.24",
    "next-auth": "^4.24.15",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "superjson": "^2.2.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/eslint": "^8.56.2",
    "@types/node": "^20.11.20",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.24",
    "postcss": "^8.4.34",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "prisma": "7.10.0",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "tsx": "4.23.13",
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@9.0.5"
}
