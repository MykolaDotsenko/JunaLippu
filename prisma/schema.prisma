generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// NextAuth models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts     Account[]
  sessions     Session[]
  reservations Reservation[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Railway domain
model Reservation {
  reservation_id Int    @id @default(autoincrement())
  seat_id        Int
  user_id        String
  trip_id        String
  dep_stop_id    String
  arriv_stop_id  String
  price_cents    Int
  departure_time String
  arrival_time   String

  seat           Seat @relation(fields: [seat_id], references: [seat_id])
  user           User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  trip           Trip @relation(fields: [trip_id], references: [trip_id])
  departure_stop Stop @relation("ReservationDepartureStop", fields: [dep_stop_id], references: [stop_id])
  arrival_stop   Stop @relation("ReservationArrivalStop", fields: [arriv_stop_id], references: [stop_id])
  segments       ReservationSegment[]

  @@index([user_id])
  @@index([trip_id, seat_id])
}

model ReservationSegment {
  reservation_id Int
  trip_id        String
  seat_id        Int
  stop_sequence  Int

  reservation Reservation @relation(fields: [reservation_id], references: [reservation_id], onDelete: Cascade)

  @@id([reservation_id, stop_sequence])
  @@unique([trip_id, seat_id, stop_sequence])
  @@index([trip_id, seat_id])
}

model Train {
  train_id     Int    @id
  train_number String

  route       Route?
  composition Train_composition[]
}

model Car {
  car_id Int @id

  composition Train_composition?
  seats       Seat[]
}

model Seat {
  seat_id      Int @id
  seat_number  Int
  car_id       Int
  travel_class Int

  car          Car @relation(fields: [car_id], references: [car_id])
  reservations Reservation[]
}

model Train_composition {
  train_id   Int
  car_id     Int @unique
  car_number Int

  train Train @relation(fields: [train_id], references: [train_id])
  car   Car   @relation(fields: [car_id], references: [car_id])

  @@id([train_id, car_id])
}

model Trip {
  trip_id      String @id
  route_id     String
  service_id   String
  service_date String

  stop_times   Stop_time[]
  route        Route @relation(fields: [route_id], references: [route_id])
  service      Calendar @relation(fields: [service_id], references: [service_id])
  reservations Reservation[]

  @@index([service_date])
}

model Route {
  route_id        String @id
  route_long_name String
  train_id        Int    @unique

  trips Trip[]
  train Train @relation(fields: [train_id], references: [train_id])
}

model Stop_time {
  stop_id        String
  trip_id        String
  arrival_time   String
  departure_time String
  stop_sequence  Int

  stop Stop @relation(fields: [stop_id], references: [stop_id])
  trip Trip @relation(fields: [trip_id], references: [trip_id])

  @@id([stop_id, trip_id, stop_sequence])
  @@unique([trip_id, stop_sequence])
  @@index([trip_id, stop_sequence])
}

model Stop {
  stop_id   String @id
  stop_name String

  stop_times             Stop_time[]
  departure_reservations Reservation[] @relation("ReservationDepartureStop")
  arrival_reservations   Reservation[] @relation("ReservationArrivalStop")
}

model Calendar {
  service_id String  @id
  monday     Boolean
  tuesday    Boolean
  wednesday  Boolean
  thursday   Boolean
  friday     Boolean
  saturday   Boolean
  sunday     Boolean

  trips Trip[]
}
